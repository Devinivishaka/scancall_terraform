# =========================================================
# ScanCall — Dev Environment Terraform Variables
# =========================================================
# Copy this file to terraform.tfvars and fill in your values.
# DO NOT commit terraform.tfvars to version control.

aws_region   = "eu-west-1"  # Ireland — your existing AWS account region
environment  = "dev"
project_name = "scancall"

# ---- Networking ----
vpc_cidr      = "10.0.0.0/16"
# true = single NAT Gateway (saves ~$30/month in dev; use false for staging/prod HA)
single_nat_gateway = true

# ---- Database ----
db_name            = "scancall_database"
db_master_username = "scancalladmin"
# Password is auto-generated and stored in Secrets Manager.
# db_master_password = "" # Optional: specify custom password or leave commented for auto-generation

# ---- SSH Key (LiveKit EC2) ----
# Leave empty to auto-generate a .pem file in terraform/
# Or paste your public key: ssh_public_key = "ssh-rsa AAAA..."
ssh_public_key = ""

# ---- Domain & SSL ----
# Leave empty to use plain HTTP via the ALB DNS name (fine for dev)
# For staging/prod: set to your domain (e.g. "scancalldev.protonestpcb.store")
domain_name     = ""
certificate_arn = "" # Paste ACM cert ARN if already created (e.g. "arn:aws:acm:eu-west-1:...:certificate/...")
redirect_http_to_https = false # Set to true to enforce HTTPS redirection on port 80

# ---- WAF (set to true for staging/prod) ----
enable_waf = false

# ---- Optional Application Secrets ----
# Leave empty to let Terraform generate random keys or manage them directly in AWS Secrets Manager.
# Do NOT commit production secrets to Git.
# internal_api_key     = ""
# jwt_secret           = ""
# livekit_api_key      = ""
# livekit_api_secret   = ""
# service_account_path = ""
# apns_auth_key        = ""
# apns_team_id         = ""
# apns_key_id          = ""
# apns_bundle_id       = "com.protonest.scancall"
# apns_host            = "https://api.push.apple.com"
# app_aws_access_key   = ""
# app_aws_secret_key   = ""
# sms_api_key          = ""
# relay_api_key        = ""
