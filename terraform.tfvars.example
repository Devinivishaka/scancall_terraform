# =========================================================
# ScanCall — Production Environment Terraform Variables
# =========================================================
# Copy this file to terraform.tfvars and fill in your values.
# DO NOT commit terraform.tfvars to version control.

aws_region   = "eu-west-1"  # Ireland — matches your AWS account
environment  = "prod"
project_name = "scancall"

# ---- Networking ----
vpc_cidr           = "10.0.0.0/16"
# false = redundant Dual NAT Gateways across AZ1 and AZ2 for Production High Availability
single_nat_gateway = false

# ---- Database ----
db_name            = "scancall_database"
db_master_username = "scancalladmin"
db_instance_class  = "db.t4g.micro" # e.g. db.t4g.micro, db.t4g.small, db.t3.medium
# Password is auto-generated and stored in Secrets Manager.
# db_master_password = "" # Optional: specify custom password or leave commented for auto-generation

# ---- SSH Key & Compute (LiveKit EC2) ----
# Leave empty to auto-generate a .pem file in terraform/
# Or paste your public key: ssh_public_key = "ssh-rsa AAAA..."
ssh_public_key        = ""
# livekit_instance_type = "t3.small" # Optional: override default instance type (prod defaults to t3.large)

# ---- Domain & SSL ----
# Set to your production domain and ACM certificate
domain_name            = ""
certificate_arn        = "" # Paste ACM cert ARN (e.g. "arn:aws:acm:eu-west-1:...:certificate/...")
redirect_http_to_https = true # Enforce HTTPS redirection in production

# ---- LiveKit WebRTC ----
# livekit_url = "wss://media.scancall.com"

# ---- Application URLs (Update with production frontend domains) ----
# cors_allowed_origins     = "https://app.scancall.com,https://admin.scancall.com"
# admin_frontend_url       = "https://admin.scancall.com"
# frontend_url             = "https://app.scancall.com"
# super_admin_frontend_url = "https://superadmin.scancall.com"

# ---- Optional Application Secrets ----
# Leave empty to let Terraform generate random keys or manage them directly in AWS Secrets Manager.
# Do NOT commit production secrets to Git.
# internal_api_key     = ""
# jwt_secret           = ""
# livekit_api_key      = ""
# livekit_api_secret   = ""
# service_account_path = ""
# apns_auth_key        = ""
# apns_team_id         = ""
# apns_key_id          = ""
# apns_bundle_id       = "com.protonest.scancall"
# apns_host            = "https://api.push.apple.com"
# app_aws_access_key   = ""
# app_aws_secret_key   = ""
# sms_api_key          = ""
# relay_api_key        = ""
